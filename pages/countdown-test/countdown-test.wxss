/* pages/countdown-test/countdown-test.wxss */
.container {
  padding: 20px;
}

.title {
  font-size: 18px;
  font-weight: bold;
  color: #333;
  margin-bottom: 30px;
  text-align: center;
}

.section {
  margin-bottom: 30px;
  padding: 15px;
  background-color: #f5f5f5;
  border-radius: 8px;
}

.section-title {
  font-size: 14px;
  color: #666;
  margin-bottom: 10px;
}

.note {
  margin-top: 40px;
  padding: 15px;
  background-color: #fff3cd;
  border-radius: 8px;
  border-left: 4px solid #ffc107;
}

.note-title {
  display: block;
  font-weight: bold;
  color: #856404;
  margin-bottom: 10px;
}

.note text {
  display: block;
  font-size: 12px;
  color: #856404;
  line-height: 1.8;
}
