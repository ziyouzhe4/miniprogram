/* compoents/countdown/index.wxss */

/* 容器：横向布局，垂直居中 */
.countdown-container {
  display: flex;
  flex-direction: row;
  align-items: center;
  height: 20px;
}

/* 圆角时间标签（天、时、分、秒）*/
.time-label {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 24rpx;
  height: 20px;
  padding: 0 4px;
  background-color: #FFFFFF;
  color: #0C0C0D;
  font-size: 12px;
  font-weight: 500;
  text-align: center;
  border-radius: 4px;
  box-sizing: border-box;
}

/* 天数标签：自适应宽度，最小宽度等于高度 */
.day-label {
  min-width: 20px;
}

/* 圆形分隔符（替代冒号）：6x6 圆形 */
.circular-separator {
  width: 6px;
  height: 6px;
  background-color: #0C0C0D;
  border-radius: 50%; /* 圆形 */
  margin: 0 3px; /* 左右间距 */
  flex-shrink: 0;
}

/* 普通文本标签（前缀、后缀等）*/
.text-label {
  font-size: 16px;
  color: #0C0C0D;
  line-height: 20px;
  white-space: nowrap;
}

/* 前缀标签间距 */
.prefix-label {
  margin-right: 6px;
}

/* 天的后缀标签间距 */
.day-suffix-label {
  margin-left: 6px;
  margin-right: 6px;
}

/* 末尾文案标签间距 */
.final-suffix-label {
  margin-left: 6px;
}
